# ============ 应用 ============
APP_NAME=雨范 AI 短视频工作台 API
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 带 Cookie 的跨域请求才需要 true；纯 Bearer 认证时保持默认即可
# CORS_ALLOW_CREDENTIALS=true

# ============ 数据库 ============
# 开发默认 sqlite（零依赖）；生产改成 postgresql+asyncpg://user:pass@host:5432/app
# 默认值留空即可：程序会指向 api/var/app.db 的**绝对路径**，从哪个目录启动都是同一个库。
# 只有想换位置时才设置；写相对路径（./var/app.db）会随 cwd 变化，通常不是你要的。
# DB_URL=sqlite+aiosqlite:///./var/app.db
DB_ECHO=false
# 连接池（sqlite 忽略这两项；PG 上按实例规格调）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ============ 鉴权 ============
# 未登录访问：留空 = dev/test 自动放开、prod 关闭（推荐）。
# 需要本地固定放开时再取消下面这行注释；生产环境开启会直接启动失败。
# ALLOW_ANONYMOUS=true
# 生产必须替换：openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
# 刷新令牌有效期（秒），默认 7 天；续期时滑动延长
REFRESH_TOKEN_TTL_SECONDS=604800
# 登录审计保留天数，超过的用 `app prune-logins` 清理（不会自动跑）
LOGIN_EVENT_RETENTION_DAYS=90
# 可信反向代理（逗号分隔的 IP / 网段）。留空 = 不信任任何代理，`X-Forwarded-For` 一律忽略。
# 部署在 nginx / ingress 后面时**必须**配：否则所有请求的直连地址都是代理，
# 登录限流键退化成「只按用户名」，一个人就能把别人锁在外面。
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ============ 基础设施（策略选择：换实现只改这里）============
# 名字对应 src/infra/<kind>/<name>.py 里的 Driver，未实现时启动即报错
STORAGE_DRIVER=local
# 本地存储根目录（留空 = 程序锚定 api/var/storage 的绝对路径）。
# 不要写 ./var/storage：相对路径随 cwd 变化，在 api/ 和 api/src 下启动会落到两个目录。
# STORAGE_LOCAL_ROOT=
STORAGE_PUBLIC_BASE=/static

QUEUE_DRIVER=memory
# 归档盘驱动：名字对应 src/infra/archive/<name>.py 里的 Driver
ARCHIVE_DRIVER=local
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# 周期任务调度器：关掉后 @periodic 注册的任务不会执行（多副本部署时务必确认幂等）
SCHEDULER_ENABLED=true

# ============ 模型供应商 ============
# 逗号分隔，可同时启用多个：AI_PROVIDERS=echo,agnes
# 每个名字对应 src/infra/ai/<name>.py
# 顺序有意义：每种能力（video / image / audio）的「默认模型」取先注册的那个。
AI_PROVIDERS=agnes,echo,libtv
# 兼容旧的单值写法（AI_PROVIDERS 优先）；新部署不要再用它
# AI_PROVIDER=echo

# ---------- 驱动私有配置 ----------
# 约定：前缀 = 驱动名大写 + `_`，Config 类写在各自的驱动文件里（infra/driver_config.py）。
# 这类参数**不要**加回 core/config.py：那里只放「所有驱动共有」的部署策略。
#
# 归档盘（共享盘 UNC 或本地目录）。留空时归档类接口会明确报「未配置」，
# 不会猜一个盘符，也不会静默回退本地磁盘。
MEDIA_ARCHIVE_ROOT=
# LibTV 旧运行时，仅「替换生成」需要；未配置时该功能会报错并提示配置项名
LIBTV_LEGACY_ROOT=
LIBTV_NODE=node
# Agnes 生图（OpenAI 兼容的同步接口，密钥在控制台创建）
AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_API_KEY=
AGNES_MODEL=agnes-image-2.5-flash
# 同步出图，超时要覆盖整个生成过程（实测约 13 秒）
# AGNES_TIMEOUT_SEC=180
# 成图落盘：下载供应商返回的图片前的域名白名单（逗号分隔）。
# 留空时只拒绝**非公网** IP 字面量 / 环回 / 内网 / 元数据地址，且不解析 DNS，
# 域名解析到内网时拦不住。生产环境必须填，启动期会断言（R12-04）。
# 例（Agnes 实测 CDN）：IMAGE_ASSET_ALLOWED_HOSTS=cos-platform-outputs.agnes-ai.cn
IMAGE_ASSET_ALLOWED_HOSTS=
# 单张成图的大小上限（字节），超限提前断开连接
# IMAGE_ASSET_MAX_BYTES=20971520
# IMAGE_ASSET_TIMEOUT_SEC=60

# S3 / MinIO 对象存储（STORAGE_DRIVER=s3 时生效）
# 自建 MinIO 填内网地址（如 http://10.0.0.12:9000），留空表示 AWS 官方。
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# 内网 MinIO 没有证书时改成 false，同时 endpoint 用 http://
S3_USE_SSL=true
# 自签证书环境才需要关掉校验，生产保持 true
S3_VERIFY=true

# ============ 生成编排 ============
# 轮询用「延迟投递」实现，不占 worker 槽位，可以设得比较密
GENERATION_POLL_INTERVAL_SEC=2.0
# 轮询次数与超时时间必须匹配：MAX_POLLS × INTERVAL 撑不到 TIMEOUT 时启动期直接报错。
# 这两个值语义不同：MAX_POLLS 是「本次进程内的轮询次数」（重启归零），
# TIMEOUT 才是真正的墙钟预算（按任务创建时间算）。
GENERATION_MAX_POLLS=900
GENERATION_TIMEOUT_SEC=1800
