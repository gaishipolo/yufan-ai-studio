# ============ 应用 ============
APP_NAME=雨范 AI 短视频工作台 API
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 数据库 ============
# 开发默认 sqlite（零依赖）；生产改成 postgresql+asyncpg://user:pass@host:5432/app
# 默认值留空即可：程序会指向 api/var/app.db 的**绝对路径**，从哪个目录启动都是同一个库。
# 只有想换位置时才设置；写相对路径（./var/app.db）会随 cwd 变化，通常不是你要的。
# DB_URL=sqlite+aiosqlite:///./var/app.db
DB_ECHO=false

# ============ 鉴权 ============
# 未登录访问：留空 = dev/test 自动放开、prod 关闭（推荐）。
# 需要本地固定放开时再取消下面这行注释；生产环境开启会直接启动失败。
# ALLOW_ANONYMOUS=true
# 生产必须替换：openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
# 刷新令牌有效期（秒），默认 7 天；续期时滑动延长
REFRESH_TOKEN_TTL_SECONDS=604800
# 登录审计保留天数，超过的用 `app prune-logins` 清理（不会自动跑）
LOGIN_EVENT_RETENTION_DAYS=90
# 可信反向代理（逗号分隔的 IP / 网段）。留空 = 不信任任何代理，`X-Forwarded-For` 一律忽略。
# 部署在 nginx / ingress 后面时**必须**配：否则所有请求的直连地址都是代理，
# 登录限流键退化成「只按用户名」，一个人就能把别人锁在外面。
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ============ 基础设施（扩展点：换实现只改这里）============
# 名字对应 src/infra/<kind>/<name>.py 里的 Driver，未实现时启动即报错
STORAGE_DRIVER=local
# 同理：留空 = api/var/storage（绝对路径）
# STORAGE_LOCAL_ROOT=./var/storage
STORAGE_PUBLIC_BASE=/static

QUEUE_DRIVER=memory
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# 逗号分隔，可同时启用多个供应商：AI_PROVIDERS=echo,volcengine
# 每个名字对应 src/infra/ai/<name>.py
AI_PROVIDERS=echo

# ============ 生成编排 ============
# 轮询用「延迟投递」实现，不占 worker 槽位，可以设得比较密
GENERATION_POLL_INTERVAL_SEC=2.0
GENERATION_MAX_POLLS=150
GENERATION_TIMEOUT_SEC=1800
