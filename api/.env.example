# ============ 应用 ============
APP_NAME=雨范 AI 短视频工作台 API
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# `app seed` 种出来的演示账号。演示数据是跨模块连贯的：任务属于这个用户、
# 分镜引用模板，各模块的行都指向同一个 id。改这里就等于换一个演示主人。
DEMO_USER_ID=u_001
DEMO_USER_NAME=老大
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 带 Cookie 的跨域请求才需要 true；纯 Bearer 认证时保持默认即可
# CORS_ALLOW_CREDENTIALS=true

# ============ 数据库 ============
# 开发默认 sqlite（零依赖）；生产改成 postgresql+asyncpg://user:pass@host:5432/app
# 默认值留空即可：程序会指向 api/var/app.db 的**绝对路径**，从哪个目录启动都是同一个库。
# 只有想换位置时才设置；写相对路径（./var/app.db）会随 cwd 变化，通常不是你要的。
# DB_URL=sqlite+aiosqlite:///./var/app.db
DB_ECHO=false
# 连接池。sqlite 文件库同样用池（只有 :memory: 例外），所以下面四项都生效。
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# 借连接最多等多久（秒）。默认 30 秒太长：池满时每个请求都安静地挂在那里，
# 看起来像服务没响应，日志里却一条错误都没有。5 秒后快速失败，返回 503。
# DB_POOL_TIMEOUT=5
# 连接最长复用时长（秒）。PG 侧被中间件掐掉空闲连接后，拿到的是半开连接。
# DB_POOL_RECYCLE=1800
# 单条语句的服务端超时（毫秒，仅 PG；0 = 不设）。没有它会有一条慢查询把池占满。
# DB_STATEMENT_TIMEOUT_MS=0

# ============ 鉴权 ============
# 未登录访问：留空 = dev/test 自动放开、prod 关闭（推荐）。
# 需要本地固定放开时再取消下面这行注释；生产环境开启会直接启动失败。
# ALLOW_ANONYMOUS=true
# 生产必须替换：openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
# 刷新令牌有效期（秒），默认 7 天；续期时滑动延长
REFRESH_TOKEN_TTL_SECONDS=604800
# 登录审计保留天数，超过的用 `app prune-logins` 清理（不会自动跑）
LOGIN_EVENT_RETENTION_DAYS=90
# 可信反向代理（逗号分隔的 IP / 网段）。留空 = 不信任任何代理，`X-Forwarded-For` 一律忽略。
# 部署在 nginx / ingress 后面时**必须**配：否则所有请求的直连地址都是代理，
# 登录限流键退化成「只按用户名」，一个人就能把别人锁在外面。
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ============ 基础设施（策略选择：换实现只改这里）============
# 名字对应 src/infra/<kind>/<name>.py 里的 Driver，未实现时启动即报错
STORAGE_DRIVER=local
# 本地存储根目录（留空 = 程序锚定 api/var/storage 的绝对路径）。
# 不要写 ./var/storage：相对路径随 cwd 变化，在 api/ 和 api/src 下启动会落到两个目录。
# STORAGE_LOCAL_ROOT=
STORAGE_PUBLIC_BASE=/static

# memory = 进程内（开发 / 单测，重启即丢）；db = 落 queued_jobs 表（重启不丢）。
# 生产建议 db：内存队列会让「已入队但还没跑」的任务在发版时静默消失。
# 将来接 redis：新增 src/infra/queue/redis.py（Driver = 你的类）后改这里，
# 业务代码与协议都不动；它自己的连接参数放 RedisQueueSettings（REDIS_* 前缀）。
QUEUE_DRIVER=memory
# 租约时长（秒）：job 被领走后多久没续租就认为「领的人崩了」，可被别人接手。
# worker 在 handler 执行期间按它的 1/4 续租，所以**不需要**大于 handler 的最长耗时；
# 它只决定「崩溃后多久被别人接走」。调小 = 恢复更快，代价是抖动更容易被误判。
QUEUE_LEASE_SEC=300
# 空队列时的轮询间隔（秒）。db 驱动每个 worker 每这么久查一次库。
QUEUE_POLL_INTERVAL_SEC=0.2
# 连续空转时退避的封顶间隔（秒）。它就是「空闲时入队到被取走」的最坏延迟：
# 1 秒换来空转查询少 5 倍；调小到等于上面那个值 = 取消退避。
QUEUE_IDLE_MAX_INTERVAL_SEC=1.0
# 缓存驱动：memory = 进程内（默认），随进程消失；redis 等共享实现未落地时启动即报错。
# 只放可丢失的加速数据。会话/令牌/任务状态的权威来源在 DB，不能只放缓存。
# 限流计数也落在这里：多实例部署要用共享缓存，否则「每分钟 60 次」会变成 60×N。
CACHE_DRIVER=memory
# 缓存键前缀：多个环境共用一个 Redis 时靠它隔离。改名只会让旧键全部 miss（无害）。
CACHE_KEY_PREFIX=yufan
# 内存缓存的条目上限（先清过期，再按 LRU 淘汰）。设 0 等于无上限 = 内存泄漏。
# CACHE_MAX_ENTRIES=10000

# ============ 事件 outbox（可靠投递）============
# 进程内事件总线是「尽力而为」：订阅者抛异常只记日志，进程崩了事件就丢。
# 需要「业务提交成功 → 事件一定被投递」的链路走 outbox：事件与业务行同一个事务落库，
# 由周期任务补投。语义是**至少一次**，订阅方必须幂等。
OUTBOX_ENABLED=true
# 补投间隔（秒）：只在有积压时才有实际动作
OUTBOX_DISPATCH_INTERVAL_SEC=5
# 每轮最多投多少条：一批太大时一条慢订阅者会拖住整轮
OUTBOX_BATCH_SIZE=100
# 投递重试上限，到顶转 failed 留档，不再无限重投
OUTBOX_MAX_ATTEMPTS=5
# 终态（已投递 / 已失败）事件的保留天数，到点由周期任务清理。
# pending 永远不清——那是还没发出去的事件。
OUTBOX_RETENTION_DAYS=7

# ============ 限流 ============
# 总开关。计数落 CACHE_DRIVER，所以多实例要配共享缓存才准。
RATE_LIMIT_ENABLED=true
# 默认额度（次/分钟）。只在路由显式 `Depends(rate_limit(...))` 时生效。
RATE_LIMIT_DEFAULT_PER_MIN=60
# 全局兜底额度（次/分钟，按客户端 IP 计）。**0 = 关闭**，这也是默认值。
# 开启前先想清楚两件事：① 反代/NAT 后面一个出口 IP 代表很多真实用户，额度定小了
# 是「整栋楼一起 429」；② `scope["client"]` 在反代后面是代理地址，除非部署层已正确
# 透传真实 IP，否则这个维度本身就是错的。它防的是脚本扫接口，不是用户点太快。
RATE_LIMIT_GLOBAL_PER_MIN=0
# 按 scope 覆盖额度：JSON，例如 {"task.create": 120, "asset.upload": 10}。
# 路由上写的是基线，这里是运维的修正值——改额度不用发版。
# 写错（非法 JSON / 次数不是非负整数 / scope 带冒号）会让 `app doctor` 红。
RATE_LIMIT_OVERRIDES=
# 整体倍率：活动放宽写 2.0，故障收紧写 0.5，**全关写 0**。
# 先覆盖后缩放，所以 0 能盖住所有单独放宽过的接口。
RATE_LIMIT_SCALE=1.0

# ============ 备份 ============
# 自动备份（`@periodic("core.backup")`）。默认关：开着就是每天在磁盘上多一份库。
# 生产建议打开——只靠 `app backup` 手敲等于没有人跑。
BACKUP_AUTO_ENABLED=false
BACKUP_DIR=var/backups
BACKUP_INTERVAL_HOURS=24
# 保留天数；0 = 永不删除（磁盘会一直涨）。只清理形如 backup-* 且带 manifest.json
# 的目录，并按清单里的创建时间判断，不看目录 mtime。
BACKUP_RETENTION_DAYS=7
# 单条 pg_dump / pg_restore 的上限（秒）。命令卡住时会被杀掉并记一条错，
# 而不是永远占着线程池里的一个线程（取消协程不会杀掉子进程）。
BACKUP_COMMAND_TIMEOUT_SEC=3600
# PostgreSQL 客户端目录（pg_dump / pg_restore 所在）。留空 = 只从进程 PATH 找。
# DB_URL 指向 Docker/远端 PG 时客户端往往不在 PATH 里，填这个比改全局 PATH 可靠。
# BACKUP_PG_BIN_DIR=

# ============ 导出（modules/export）============
# 单次导出的行数上限。没有上限的导出等于把整张表拉进内存，
# 而 worker 是共享进程，一个大导出会把同进程里其他 job 一起拖垮。
EXPORT_MAX_ROWS=100000
# 产物保留小时数。到期只删字节、保留记录（状态转 expired）。
EXPORT_TTL_HOURS=168
# queued/running 超过这么久没推进就判为丢失。必须大于 worker 的 job 超时。
EXPORT_STALE_AFTER_SEC=900

# ============ 可观测（指标 / 就绪）============
# Prometheus 抓取端点 /metrics（不进 OpenAPI、不走业务鉴权）。
# 关掉时返回 404，不对外暴露端点存在性。
METRICS_ENABLED=true
# 抓取凭据：Authorization: Bearer <token>。
# 生产环境留空时 /metrics 直接 403（doctor 会提示），内部结构不该裸奔。
# METRICS_TOKEN=
# 就绪探针的降级阈值（不是存活阈值）：
# - outbox 待投递超过这个数 → degraded（事件晚投递，不是服务挂了）
# - 死信超过这个数 → degraded（需要人看，但别让整批实例被摘掉）
# HEALTH_OUTBOX_PENDING_LIMIT=1000
# HEALTH_DEAD_JOB_LIMIT=10

# ============ 功能开关 ============
# 上线前先关、出问题立刻关，避免为此回滚部署。业务侧统一 core.flags.is_on()。
# 支持 JSON 与逗号列表两种写法；显式 false 与「没声明」在语义上不同。
# FEATURE_FLAGS={"new.upload": false}
# FEATURE_FLAGS=new.upload,new.editor

# 归档盘驱动：名字对应 src/infra/archive/<name>.py 里的 Driver
ARCHIVE_DRIVER=local
# 替换任务的运行工作区（执行器要真实目录：inputs/outputs/records）。
# 留空 = 本地驱动沿用 <归档根>/runs；归档切远端时落到 api/var/runs
# REPLACEMENT_RUNS_ROOT=
# 视频模板目录（卡片 + 提示词）与封装进度文件目录。
# 留空 = api/var/video_templates/catalog.json、api/var/template-packager。
# 多机部署要指向共享盘上的同一份；不能指向对象存储——目录是「读全量→改一条→
# 写全量」，依赖同盘原子重命名，S3/MinIO 没有跨进程 CAS，并发会丢更新。
# VIDEO_TEMPLATE_CATALOG=
# TEMPLATE_PACKAGER_STATE_DIR=
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# 周期任务调度器：关掉后 @periodic 注册的任务不会执行（多副本部署时务必确认幂等）
SCHEDULER_ENABLED=true
# 周期任务协调能力：local = 单实例；backend = 用归档存储的条件写抢租约，
# 保证全集群只有一个实例执行 GC 这类不可逆任务。多副本必须设 backend。
LEADER_ELECTOR=local

# 资产库 v2 回收站：条目在回收站里放满保留期后才允许物理删除。
# 删除不可逆，所以 GC 默认关闭；单机（LEADER_ELECTOR=local）确认后再开。
# 它是小时级扫描，不是「每日 03:00」——调度器只支持间隔，没有 cron。
LIBRARY_TRASH_GC_ENABLED=false
LIBRARY_TRASH_GC_INTERVAL_SEC=3600
LIBRARY_TRASH_RETENTION_DAYS=30
LIBRARY_TRASH_GC_BATCH=200

# 资产库 v2 批量下载：展开后的条目上限与解压后总量上限（默认 2GB）。
# 超限返回 413 并提示分批；zip 保留 24 小时，过期由周期任务清字节。
LIBRARY_DOWNLOAD_MAX_ITEMS=100
LIBRARY_DOWNLOAD_MAX_BYTES=2147483648
LIBRARY_DOWNLOAD_TTL_HOURS=24
# 清的是我们自己生成的临时 zip，不是用户数据，所以默认开启。
LIBRARY_DOWNLOAD_GC_ENABLED=true
LIBRARY_DOWNLOAD_GC_INTERVAL_SEC=3600

# 出站 HTTP：调供应商、下载产物/CDN 共用同一个连接池（infra/http.py）。
# 各模块不再自己 new AsyncClient —— 否则超时、keep-alive、SSRF 校验三件事对不齐。
# HTTP_TIMEOUT_SEC=30
# 应 ≥ WORKER_CONCURRENCY × 2，超出后请求排队而不是报错
# HTTP_MAX_CONNECTIONS=100
# HTTP_USER_AGENT=yufan-ai-studio

# ============ 模型供应商 ============
# 逗号分隔，可同时启用多个：AI_PROVIDERS=echo,libtv
# 每个名字对应 src/infra/ai/<name>.py。
#
# 注意：`src/modules/model_driver/drivers/` 下的单文件驱动**不写在这里**，
# 进程启动时自动扫描载入（agnes 就是这种，见 docs/MODEL_DRIVER_STANDARD.md）。
# 「默认模型」由供应商的 `preferred_for` 声明决定，不依赖这里的顺序——
# 顺序只是「谁先注册」，而驱动永远后于本清单注册。
AI_PROVIDERS=echo,libtv
# 百炼（bailian）**不写进上面这行**：它已迁到 drivers/ 自动载入。
# 填上下面的 BAILIAN_API_KEY 之后，模板工作台的「替换渠道」会多出
# 标准版 / 高速版两个选项（没配密钥时渠道显示不可用，不会等到提交才报错）。
# 兼容旧的单值写法（AI_PROVIDERS 优先）；新部署不要再用它
# AI_PROVIDER=echo

# ---------- 运行期依赖 ----------
# node 可执行文件：提示词编译器与执行器子进程都用它。留空不必——默认 `node`。
# 旧名 `LIBTV_NODE` 已注册为别名，老部署不用改；新部署写 NODE_BINARY。
NODE_BINARY=node

# ---------- 驱动私有配置 ----------
# 约定：前缀 = 驱动名大写 + `_`，Config 类写在各自的驱动文件里（infra/driver_config.py）。
# 这类参数**不要**加回 core/config.py：那里只放「所有驱动共有」的部署策略。
#
# 归档盘（共享盘 UNC 或本地目录）。留空时归档类接口会明确报「未配置」，
# 不会猜一个盘符，也不会静默回退本地磁盘。
MEDIA_ARCHIVE_ROOT=
# LibTV 固定版适配器随代码入库（infra/ai/libtv_runtime/vendor），无需外部路径配置
# 已登录 LibTV 的本地浏览器 DevTools 地址（适配器从这里读 Cookie）
# LIBTV_BROWSER_URL=http://127.0.0.1:9226
# 阿里云百炼（单文件驱动，实现在 modules/model_driver/drivers/bailian.py）
# 模板工作台的替换渠道：Wan 只接受公网 URL 作参考素材，驱动会把本地素材
# 直传百炼签发的 OSS 临时目录，再把 oss:// 直链拼进请求体。按阿里云 API 账单计费。
BAILIAN_BASE_URL=https://llm-cz0qm1j8cl2weo19.cn-beijing.maas.aliyuncs.com/api/v1
BAILIAN_API_KEY=
BAILIAN_TIMEOUT_SEC=45
BAILIAN_DOWNLOAD_TIMEOUT_SEC=45
# Agnes 生图（单文件驱动，实现在 modules/model_driver/drivers/agnes.py）
# 支持文生图 / 图生图 / 多图合成；图生图由调用方传 referenceUrls，驱动转成
# extra_body.image。网关有两套且密钥不通用：文档写的 apihub.agnes-ai.com 需要
# 单独申请的密钥（老密钥打过去 401），默认用实测可用的 .cn 域名。
AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_API_KEY=
# 当前密钥分组可用：agnes-image-2.5-flash / agnes-image-2.1-flash。
# 文档主推的 agnes-image-2.0-flash 在该分组返回 404 model_not_found，
# 开通后再把它加进 drivers/agnes.py 的 MODELS。
AGNES_MODEL=agnes-image-2.5-flash
# 同步出图，超时要覆盖整个生成过程（实测 10-20 秒，官方建议 60-360 秒）
# AGNES_TIMEOUT_SEC=180
# 成图落盘：下载供应商返回的图片前的域名白名单（逗号分隔）。
# 留空时只拒绝**非公网** IP 字面量 / 环回 / 内网 / 元数据地址，且不解析 DNS，
# 域名解析到内网时拦不住。生产环境必须填，启动期会断言（R12-04）。
# 例（Agnes 实测 CDN）：IMAGE_ASSET_ALLOWED_HOSTS=cos-platform-outputs.agnes-ai.cn
IMAGE_ASSET_ALLOWED_HOSTS=
# 单张成图的大小上限（字节），超限提前断开连接
# IMAGE_ASSET_MAX_BYTES=20971520
# IMAGE_ASSET_TIMEOUT_SEC=60

# S3 / MinIO 对象存储（STORAGE_DRIVER=s3 时生效）
# 切换步骤（三件事，缺一件就会「列表还在、点开 404」）：
#   1. 配好下面四项 + STORAGE_DRIVER=s3
#   2. `app migrate-storage`：把 STORAGE_LOCAL_ROOT 下的对象按 key 原样搬进桶，
#      并把库里 `/static/...` 的旧地址改写成桶地址
#   3. 桶配公开读（`url_for` 拼的是直连地址），或让前端改走预签名接口
# 本地目录默认保留作回滚依据；确认无误后再 `--delete-source` 或手工清。
# 自建 MinIO 填内网地址（如 http://10.0.0.12:9000），留空表示 AWS 官方。
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# 内网 MinIO 没有证书时改成 false，同时 endpoint 用 http://
S3_USE_SSL=true
# 自签证书环境才需要关掉校验，生产保持 true
S3_VERIFY=true

# 归档对象存储（ARCHIVE_DRIVER=s3 时生效；端点与凭据复用上面的 S3_*）
# 默认 separate = 独立私有桶：素材桶对浏览器公开读，归档桶只给本机进程读，
# 共用一个桶等于把私有原片放进公开读范围。
# shared = 两条通路共用 S3_BUCKET，归档对象统一落在 `archive/` 前缀下，
# 共用同一个 boto3 client；仅在桶策略已按前缀管控、且没有公开读时才可用。
# 切换后运行工作区不再放在归档里，用 REPLACEMENT_RUNS_ROOT 指定本地目录。
S3_BUCKET_MODE=separate
# S3_ARCHIVE_BUCKET=   # separate 必填；shared 模式下留空并改用 S3_BUCKET
# 多环境共用归档桶时按前缀隔离
# S3_ARCHIVE_PREFIX=
# 物化缓存目录（远端驱动把字节下到这里再交给 ffmpeg/桥接层），默认 api/var/archive-cache
# S3_ARCHIVE_CACHE_DIR=

# ============ 生成编排 ============
# 轮询用「延迟投递」实现，不占 worker 槽位，可以设得比较密
GENERATION_POLL_INTERVAL_SEC=2.0
# 轮询次数与超时时间必须匹配：MAX_POLLS × INTERVAL 撑不到 TIMEOUT 时启动期直接报错。
# 这两个值语义不同：MAX_POLLS 是「本次进程内的轮询次数」（重启归零），
# TIMEOUT 才是真正的墙钟预算（按任务创建时间算）。
GENERATION_MAX_POLLS=900
GENERATION_TIMEOUT_SEC=1800
