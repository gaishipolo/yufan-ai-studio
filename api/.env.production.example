# ============================================================================
# 生产环境 .env 模板
#
# 用法：复制为 api/.env，把 <...> 占位全部替换掉。不要把真实密钥提交进仓库。
# 守卫：APP_ENV=prod 时，JWT_SECRET 弱值 / DEBUG=true / ALLOW_ANONYMOUS=true /
#       CORS_ORIGINS=* / S3 四项缺失 / 两个域名白名单缺失，都会在**启动时**失败。
#       JWT_SECRET 故意用 change-me 前缀占位：忘了替换就起不来，而不是裸奔上线。
#
# 启动顺序（prod 不会自动建表，顺序错了会 500 或没人能登录）：
#   1. 配好本文件
#   2. cd api && alembic upgrade head
#   3. app create-admin --username admin --password '<强口令>'
#   4. app doctor --strict
#   5. cd ../studio && npm ci && npm run build    # 后端要发这份产物，先构建
#   6. app serve --host 127.0.0.1 --port 8080     # 页面与接口同一个端口；局域网直连填 0.0.0.0
#   7. （用到 LibTV 替换模型才需要）另起两个登录浏览器，与后端互不影响：
#      powershell -ExecutionPolicy Bypass -File .\start-services.ps1 -BrowsersOnly
#      详见 README §2.6；起完不需要重启后端，浏览器是在每次上传/提交前才探测的。
#
# 发版顺序：git pull → alembic upgrade head → app doctor --strict → npm run build
#           → **按原方式重启后端**（配置全部在启动时读入，不重启等于没改）
# ============================================================================

# ============ 应用 ============
APP_NAME=雨范 AI 短视频工作台 API
APP_ENV=prod
DEBUG=false
API_PREFIX=/api/v1
# 浏览器里**页面所在的 origin**（scheme://host:port），不是服务器 IP —— 同源策略比的
# 是地址栏那个地址，所以判断方法是「用户打开页面时地址栏写的是什么」。
# 后端托管前端（见 WEB_DIST_DIR）时页面与接口同源，这项根本不参与，留空也能启动；
# 只有页面由另一个源提供时（另开端口的前端、别的域名）才必须写，漏一个就是那台机器全挂。
# 多个用逗号分隔；逐字符精确匹配，带尾斜杠、或用主机名替代 IP 访问，都算另一个源。
# 生产守卫只拦 `*`（`allow_credentials=true` 时浏览器本来也不接受通配）。
CORS_ORIGINS=https://studio.example.com
# 反代后面必配：否则 X-Forwarded-For 被忽略，登录限流键退化成「只按用户名」，
# 一个人就能把别人锁在外面。同机 nginx 填 127.0.0.1；前面还有 LB 时填 LB 的网段。
TRUSTED_PROXIES=127.0.0.1
# 前端构建产物目录。填了 = 后端同时发页面和接口，生产只开 8080 一个端口，
# 不需要 nginx、也不需要跨域；相对路径按**仓库根**解析（`studio/dist` / `../studio/dist` 都认）。
# 留空 = 只发接口，页面交给 nginx（见 README「部署」§3）或 vite（开发时 5173）。
# 目录里没有 index.html 时按「没配」处理：先起后端、后构建不会启动失败。
WEB_DIST_DIR=studio/dist
# 不设置 = prod 自动关闭匿名回退。显式写 false 也可以，写 true 会启动失败。
# ALLOW_ANONYMOUS=false

# ============ 数据库 ============
# PG 必填；sqlite 不适合生产（多进程写锁 + 队列/查询吞吐）。
# 客户端大版本不要高于服务端（PG17 dump 灌进 PG16 会因 transaction_timeout 报错）。
DB_URL=postgresql+asyncpg://<user>:<password>@<db-host>:5432/yufan_studio
DB_ECHO=false
# 池满时快速失败而不是让请求安静挂着。设 5 秒，日志里能看到 503 而不是「服务没响应」。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
# 单条语句服务端超时（毫秒，仅 PG）。没有它，一条慢查询能把整个池占满。
DB_STATEMENT_TIMEOUT_MS=30000

# ============ 鉴权 ============
# 必须替换：openssl rand -hex 32。当前值是弱前缀占位，忘了换会启动失败。
JWT_SECRET=change-me-REPLACE-WITH-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_EVENT_RETENTION_DAYS=90

# ============ 基础设施 ============
# db = 落 queued_jobs 表，重启不丢。memory 会让「已入队还没跑」的任务在发版时静默消失。
QUEUE_DRIVER=db
QUEUE_LEASE_SEC=300
QUEUE_POLL_INTERVAL_SEC=0.2
QUEUE_IDLE_MAX_INTERVAL_SEC=1.0
# 目前只有 memory：多实例时「每分钟 60 次」会变成 60×N，共享缓存尚未落地。
# 生产请维持**单实例**，或在反代层做限流。
CACHE_DRIVER=memory
CACHE_KEY_PREFIX=yufan
# 单实例锁；多副本改 backend（用归档存储的条件写抢租约，GC 只跑一个）。
LEADER_ELECTOR=local
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# 单个账号最多几条任务在途（queued + running），0 = 不限。
# 队列是 FIFO：一个人攒几十条会把别人的任务顶到十几分钟之后，而限流只拦频率。
# 容量怎么算、这条为什么是 5，见 docs/CAPACITY.md。
TASK_MAX_IN_FLIGHT_PER_USER=5
SCHEDULER_ENABLED=true
# 视频任务巡检：15 分钟没写入的 queued/running 任务接回轮询（链路断了会卡 running）。
TASK_RECONCILE_ENABLED=true
TASK_RECONCILE_STALE_SEC=900
TASK_RECONCILE_INTERVAL_SEC=300

# 事件 outbox：业务提交成功 → 事件一定投递（至少一次，订阅方必须幂等）。
OUTBOX_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_SEC=5
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=7

# ============ 限流 ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=60
# 全局兜底按客户端 IP 计：反代/NAT 后一个出口 IP 代表很多人，默认 0（关）。
RATE_LIMIT_GLOBAL_PER_MIN=0
# 运维修正值，JSON；改额度不用发版。非法 JSON / scope 带冒号会让 doctor 红。
# RATE_LIMIT_OVERRIDES={"task.create": 120}
RATE_LIMIT_SCALE=1.0

# ============ 备份 ============
# 只靠手敲 app backup 等于没人跑。开着，并**演练过恢复**。
BACKUP_AUTO_ENABLED=true
# 用绝对路径：计划任务拉起时 cwd 未必是 api/，相对路径会落到别处。
BACKUP_DIR=<绝对路径>/var/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_COMMAND_TIMEOUT_SEC=3600
# pg_dump / pg_restore 所在目录。计划任务的 PATH 未必带它，写绝对路径比改全局 PATH 可靠。
BACKUP_PG_BIN_DIR=<pg_dump 所在目录，例如 C:\Program Files\PostgreSQL\17\bin>

# ============ 可观测 ============
# 留空则 /metrics 返回 403（doctor 会提示）。生成：openssl rand -hex 32
METRICS_ENABLED=true
METRICS_TOKEN=<openssl rand -hex 32 的输出>
# HEALTH_OUTBOX_PENDING_LIMIT=1000
# HEALTH_DEAD_JOB_LIMIT=10

# ============ 对象存储 ============
# 素材桶与归档桶分开：素材桶靠预签名读，归档桶只给本机进程读。
STORAGE_DRIVER=s3
S3_ENDPOINT=http://<minio-host>:9000
S3_BUCKET=<素材桶名，私有，靠预签名读>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_REGION=us-east-1
# 内网 http endpoint 时关掉；公网/https 保持 true。
S3_USE_SSL=false
# 自签证书才改 false，生产默认 true。
S3_VERIFY=true

ARCHIVE_DRIVER=s3
S3_BUCKET_MODE=separate
S3_ARCHIVE_BUCKET=<归档桶名，私有>
# S3_ARCHIVE_PREFIX=
# 远端驱动把字节物化到这里再交给 ffmpeg / 桥接层。默认 api/var/archive-cache。
# S3_ARCHIVE_CACHE_DIR=
# 归档盘根（UNC 或本地目录）：归档类接口要真实目录，留空会明确报未配置。
MEDIA_ARCHIVE_ROOT=<共享盘 UNC，例如 //host/share/yufan_ai_studio>
# 生成任务运行工作区（inputs/outputs/records）。新名字是 TASK_RUNS_ROOT，
# 旧名 REPLACEMENT_RUNS_ROOT 仍认，但新部署用新名。
TASK_RUNS_ROOT=<共享盘 UNC>/runs
# 多机部署时这两项必须指向共享盘同一份：目录是「读全量→改一条→写全量+同盘原子
# 重命名」，没有跨进程 CAS，放对象存储会丢更新。单实例可用默认的 api/var。
# VIDEO_TEMPLATE_CATALOG=
# TEMPLATE_PACKAGER_STATE_DIR=

# ============ 出站白名单（生产必填，缺一项启动即失败）============
# 成图落盘：下载供应商返回的图片前校验 host。只配实际会用到的 CDN 域名。
# 例（Agnes 实测）：cos-platform-outputs.agnes-ai.cn
IMAGE_ASSET_ALLOWED_HOSTS=<成图 CDN 域名，逗号分隔>
# 生成入库：sourceUrl 由调用方给，服务端出站取字节；白名单防 SSRF。
# 例：cos-platform-outputs.agnes-ai.cn
LIBRARY_INGEST_ALLOWED_HOSTS=<素材来源 CDN 域名，逗号分隔>
# HTTP_TIMEOUT_SEC=30
# HTTP_TOTAL_TIMEOUT_SEC=300
# HTTP_MAX_CONNECTIONS=100

# ============ 模型供应商 ============
# 驱动自动扫描注册（drivers/*.py），不在这里列「启用清单」。没配密钥的渠道显示不可用。
BAILIAN_BASE_URL=https://llm-cz0qm1j8cl2weo19.cn-beijing.maas.aliyuncs.com/api/v1
BAILIAN_API_KEY=<百炼密钥>
BAILIAN_TIMEOUT_SEC=45
BAILIAN_DOWNLOAD_TIMEOUT_SEC=45

AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_API_KEY=<Agnes 密钥>
AGNES_MODEL=agnes-image-2.5-flash
# AGNES_TIMEOUT_SEC=180

# 提示词编译器与执行器子进程都用它；服务由计划任务拉起时 PATH 未必带 node，
# 必要时写 node.exe 的绝对路径（旧名 LIBTV_NODE 仍认）。
NODE_BINARY=node

# LibTV：两个账号各自一个 Chrome、一个独立 --user-data-dir、一个独占 CDP 端口。
# 任务开始时会把用的账号写进 run.json::browser_url，之后只回那个账号查询/下载。
# 这两个浏览器不由后端拉起，要单独常驻；登录态就在 --user-data-dir 里，别删别换。
LIBTV_BROWSER_URLS=http://127.0.0.1:9411,http://127.0.0.1:9412
# 积分队列专用账号；别的账号没有积分，不配时积分队列也用默认账号。
LIBTV_CREDITS_BROWSER_URL=http://127.0.0.1:9412

# ============ 生成编排 ============
# MAX_POLLS × INTERVAL 必须撑得到 TIMEOUT，否则启动期直接报错。
GENERATION_POLL_INTERVAL_SEC=2.0
GENERATION_MAX_POLLS=900
GENERATION_TIMEOUT_SEC=1800
GENERATION_MAX_WALL_CLOCK_SEC=10800
# 产物落盘自己的预算：几百 MB 的下载塞进轮询预算会无限重跳，产物永远进不了库。
GENERATION_PERSIST_TIMEOUT_SEC=300
# 上游限流/队列满时的排队重投间隔，留空 = 直接失败。默认 8 档约 12 分钟。
GENERATION_THROTTLE_DELAYS=10,20,30,60,90,120,180,240

# ============ 导出 / 回收站 / 下载 ============
EXPORT_MAX_ROWS=100000
EXPORT_TTL_HOURS=168
EXPORT_STALE_AFTER_SEC=900
# 回收站 GC 不可逆：单实例确认后再开，多实例必须 LEADER_ELECTOR=backend。
# LIBRARY_TRASH_GC_ENABLED=false
# LIBRARY_TRASH_RETENTION_DAYS=30
LIBRARY_DOWNLOAD_MAX_ITEMS=100
LIBRARY_DOWNLOAD_MAX_BYTES=2147483648
LIBRARY_DOWNLOAD_TTL_HOURS=24
LIBRARY_DOWNLOAD_GC_ENABLED=true
LIBRARY_DOWNLOAD_GC_INTERVAL_SEC=3600

# ============ 上线后必做（脚本测不了）============
# 1. app doctor --strict 全绿
# 2. nginx 的 X-Forwarded-For 与这里的 TRUSTED_PROXIES 配套（缺一会把全站算进同一限流桶）
# 3. 备份目录里确实出现新 backup-* 且带 manifest.json，并演练过一次恢复
# 4. 切存储/切库后做一次真实字节往返：put → get 比对 → 预签名下载 → 删除
# 5. git pull 后跑一次 vendor 指纹校验（vendor 被检出成 CRLF 时 git status 是干净的）：
#    cd api && python -m pytest -q tests/test_libtv_vendor_manifest.py
