# ===== 依赖与构建产物 =====
node_modules/
dist/
# `VITE_USE_MOCK=true vite build --outDir dist-mock`：验证 mock 分包的临时产物
dist-mock/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 本地运行数据（sqlite / 上传文件 / 临时导出）=====
# 两种启动方式会落到不同目录：`app serve` 在 api/var，uvicorn 以 src 为 cwd 时在 api/src/var
# 整体忽略而不是逐个后缀：归档盘、角色迁移快照、`test-*` 临时目录都属于本地运行数据，
# 逐条放行只会让新产物默认进入待提交集合。用 `dir/*` + `!.gitkeep` 保留目录本身。
api/var/*
!api/var/.gitkeep
api/src/var/*
!api/src/var/.gitkeep

# ===== 环境变量（只提交 *.example）=====
.env
.env.local
.env.*.local
# 切换驱动前的手工备份（`cp .env .env.bak-...`），含明文密钥
.env.bak*

# ===== 日志 =====
# 只忽略根目录的本地草稿目录。和下面的 /workbench/ 同理：
# 不加前导 / 会匹配任意层级的 .local，把将来某个模块自带的同名目录一并吞掉。
/.local/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===== 编辑器与系统 =====
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ===== 本期不上传 =====
# 只忽略根目录的早期静态原型（已被 studio 取代）。必须锚定根目录：
# 不加前导 / 会连 api/src/modules/template/replacement_runtime/workbench/ 一起吞掉。
/workbench/
# .workbuddy/：本地会话与工作记忆，不属于工程内容
.workbuddy/
# .tmp/：本地排查用的临时产物（接口快照、抽帧、pytest 输出）
/.tmp/
